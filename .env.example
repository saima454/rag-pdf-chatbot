GEMINI_API_KEY=paste_your_key_here
# Text-cleaning model (change if Google renames/retires it)
GEMINI_MODEL=gemini-2.5-flash
# Embedding model
EMBED_MODEL=gemini-embedding-001

# Qdrant: leave QDRANT_URL empty for local storage (folder qdrant_db/, no server needed)
# Docker server example : QDRANT_URL=http://localhost:6333
# Qdrant Cloud example  : QDRANT_URL=https://xxxx.cloud.qdrant.io:6333  and set QDRANT_API_KEY
QDRANT_URL=
QDRANT_API_KEY=
